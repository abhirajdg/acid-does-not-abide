// ============================================================================
// DAILY — 2026-08-24 (Monday): Hindustani raga of the day — RAGA KALYAN
// ============================================================================
// Weekly rotation slot: Monday = one of the 10 parent thaats. No prior Monday
// exists in daily/ history yet, so this is the first pick — going with
// Kalyan (thaat #2) rather than re-treading Bhairav (thaat #4), which is
// already the flagship reference in sets/bhairav-session-v1.strudel.
//
// THEORY NOTES:
// Kalyan's swaras: S R G M# P D N  (all shuddh except tivra/sharp Ma)
//   -> semitone offsets from tonic: 0, 2, 4, 6, 7, 9, 11
//   -> this IS the exact interval set of the Western "lydian" mode -- no
//      substitution needed (unlike Bhairav's "gypsy" workaround), tonaljs
//      ships "lydian" natively, so .scale("D:lydian") honestly represents
//      Kalyan's scale.
//   -> tonic set to D, a common tanpura pitch for early-evening ragas
//      (Kalyan belongs to the sandhiprakash/evening slot).
//   -> scale degree numbers used in n() below map like this in "D:lydian":
//        0=S(D)  1=R(E)  2=G(F#)  3=M#(G#)  4=P(A)  5=D(B)  6=N(C#)  7=S'(D5)
//   -> vadi (dominant) = Ga = degree 2, samvadi (sub-dominant) = Ni = degree 6
//   -> phrase below, degrees: 4 3 2 4 | 2 1 0 | 4 5 6 7 (P M# G P, G R S,
//      P D N S') -- an ascending sweep through P and the tivra Ma that gives
//      Kalyan its characteristic soaring, open brightness.
//
// This is a DAILY quick clip, not a flagship set -- one continuous pattern,
// no alap/jor/jhala arc. setcpm(48) * 16 cycles = 20s (60/48 = 1.25s/cycle).
// ============================================================================

setcpm(48)
let CYCLES = 16 // 16 * 60/48 = 20s

stack(
  // drone: tonic + fifth (S and P), quiet and roomy -- grounds the tivra Ma
  // so it reads as lydian brightness rather than "a wrong note"
  note("<d2 a2>/4")
    .sound("gm_pad_warm")
    .gain(.22)
    .room(4)
    .attack(1.5).release(2.5),

  // melodic phrase -- see pakad-ish phrase note above
  n("4 3 2 4 2 1 0 ~ 4 5 6 7")
    .scale("D:lydian")
    .sound("gm_flute")
    .sometimes(x => x.ply(2)) // <- improv hook: occasional ornament
    .gain(.55)
    .room(2.5)
    .delay(.2),

  // light pulse -- euclidean, sparse, signals the beat without a full tala
  s("bd").euclid(3, 8).bank("RolandTR909").gain(.35),
  s("rim").euclid(5, 8).bank("RolandTR909").gain(.2).degradeBy(.3)
)
