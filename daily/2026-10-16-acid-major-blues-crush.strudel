// ============================================================================
// DAILY — 2026-10-16 (Friday): Acid / psychedelia free jam — major blues, bitcrush decay
// ============================================================================
//
// Friday is taste-forward, not theory-first (CREATIVE-DIRECTION.md's 10 Sep
// correction: genre structure drives Friday, not raga performance form).
// Checked every prior Friday before writing this one (MUSIC-KNOWLEDGE.md's
// "don't template last cycle" rule): 08-28 = D harmonic minor, Goa bass/lead
// split. 09-04 = E whole tone, Sound-on-Sound delay drone, wobble sub. 09-11
// = A locrian, duckorbit sidechain, psytrance bass + pad dyad. 09-18 = F
// natural minor, single 303 + one slow lpf sweep. 09-25 = E phrygian
// dominant, half-time dub, kick-locked wobble. 10-02 = G dorian, per-note
// FILTER envelope (lpenv) stacked under a slow lpf sweep, four-on-the-floor
// + clap. 10-09 = A minor pentatonic, per-note PITCH envelope (penv) under a
// slow lpf sweep, sparse kick + choked hat. Every one of those six kept a
// slow `.lpf(sine.range(...).slow(n))` sweep as the constant baseline and
// stacked one new per-note device on top. Today breaks that habit on
// purpose rather than repeating it a seventh time:
//
//   SCALE: C major blues (C D Eb E G A) — not yet used on a Friday, and the
//   first MAJOR-flavored scale this slot has reached for (every prior Friday
//   picked something minor/modal-minor; even whole tone leans ambiguous-dark).
//   Its defining color is the Eb/E clash — scale degrees 2 and 3 sit a
//   half-step apart, the "blue note" rubbing against the major 3rd. The
//   melody below deliberately plays degree 2 then 3 back to back (see phrase
//   A) so that clash is heard directly, not just implied by the scale name.
//   Degrees: 0=C 1=D 2=Eb(blue note) 3=E 4=G 5=A 6=C' 7=D'' 8=Eb'''.
//
//   PRODUCTION — the new device is automated BITCRUSH (`.crush()`), not a
//   filter or pitch envelope (both already used the last two weeks running).
//   Bitcrush is a genuinely different texture family: digital bit-depth
//   reduction/decay rather than analog-style filter or pitch movement —
//   verified against `knowledge-base/strudel/learn/effects.md` "## crush"
//   before use. Rather than stacking it as a second knob under the usual
//   slow lpf sweep, it REPLACES the sweep this week: `lpf` stays fixed, and
//   `.crush(sine.range(4,16).slow(6))` alone carries the track's one slow
//   arc, cycling the lead between heavily bit-crushed (4) and clean (16)
//   every 6 cycles — a lo-fi "dissolve and reform" breathing, which reads as
//   more psychedelic/free-jam than another filter sweep would, and keeps to
//   fewer independently-drifting knobs per §10's "don't complicate the code,
//   layer instead" correction.
//
//   DRUMS: kick (drives the sidechain) + a sparse, syncopated rimshot — no
//   hats and no clap this time (10-02 had clap+hats, 10-09 had a choked hat
//   pair). The rim pattern leaves real gaps rather than filling every
//   subdivision, so the crush-dissolve on the lead stays the thing the ear
//   tracks, not a busy top end.
//
// THE 303 LINE — 16 steps/cycle, rotating <A B C D> every cycle across 12
// cycles (3 full rounds), per MUSIC-QC-LOOP.md's real-leap/rest/development
// checklist:
//   A (call, states the  0 ~ 2 3 ~ 0 5 ~ 0 ~ 3 2 ~ 0 ~ ~  -- Eb then E back
//      blue-note clash):  to back (the blue note itself), leap up to the 6th
//                         (A) and back to tonic.
//   B (variation,        0 ~ 2 3 ~ 6 ~ 3 ~ 5 ~ 7 ~ 3 ~ ~  -- same opening,
//      unresolved):       but climbs past the octave (6) to a 9th-equivalent
//                         (7) and stops there on a rest — unresolved tension.
//   C (peak, literal     8 ~ 7 6 ~ 3 2 0 ~ 7 6 3 ~ 2 0 ~  -- leap to the blue
//      retrograde):       note an octave up (8), then B's rising core (3 5 6
//                         7) in retrograde (7 6 3), twice, settling on tonic.
//   D (release,          0 ~ ~ ~ -2 ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~  -- mostly rests,
//      sparse):           one leap BELOW the tonic (G, a 4th down), breathing
//                         room after C's peak.
//
// TEMPO: setcpm(30) with a bd*4 kick -> BPM = cpm * beats/cycle = 120, real
// acid-house territory (120-130). CYCLES: 12. 12 * 60/30 = 24s.
// ============================================================================

setcpm(30)
let CYCLES = 12

// drums — just kick (drives the sidechain) + a sparse syncopated rimshot,
// deliberately leaving gaps rather than filling every subdivision, so the
// crush-dissolve on the lead below stays the thing the ear tracks.
let drums = stack(
  s("bd*4").bank("RolandTR909")
    .duckorbit(2).duckattack(.03).duckdepth(.35)
    .gain(.56),
  s("~ rim ~ ~ rim ~ rim ~").bank("RolandTR909").gain(.2).room(.12).degradeBy(.08),
)

let melody = n(`<
  [0 ~ 2 3 ~ 0 5 ~ 0 ~ 3 2 ~ 0 ~ ~]
  [0 ~ 2 3 ~ 6 ~ 3 ~ 5 ~ 7 ~ 3 ~ ~]
  [8 ~ 7 6 ~ 3 2 0 ~ 7 6 3 ~ 2 0 ~]
  [0 ~ ~ ~ -2 ~ 0 ~ ~ ~ ~ 0 ~ ~ ~ ~]
>`).scale("C2:major:blues")

// one 303 voice, bass+lead duty. lpf stays FIXED this week (no sweep) --
// .crush() alone carries the track's one slow arc, cycling bit depth from
// heavily crushed (4) to clean (16) every 6 cycles: a lo-fi dissolve/reform
// breathing, genuinely different texture family from the filter/pitch
// envelopes the last two Fridays used. Lightly ducked by the kick (orbit 2).
let lead = melody
  .sound("square")
  .attack(.004).decay(.09).sustain(.06).release(.03)
  .lpf(900)
  .lpq(9)
  .crush(sine.range(4, 16).slow(6))
  .distort(.18)
  .pan(.4)
  .gain(.34)
  .orbit(2)

stack(drums, lead)
